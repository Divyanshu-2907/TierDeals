{
  "name": "@tierdeals/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Rule schemas and helpers shared by the TierDeals backend and admin UI.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}

{
  "name": "tierdeals",
  "version": "0.1.0",
  "private": true,
  "description": "Tiered discount rules for Shopify, powered by a Rust Shopify Function.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "web/shared",
    "web/backend",
    "web/frontend",
    "extensions/tierdeals-discount"
  ],
  "scripts": {
    "dev": "shopify app dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspace web/shared --workspace web/backend --workspace web/frontend",
    "test:function": "npm run test --workspace extensions/tierdeals-discount",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "npm run db:migrate --workspace web/backend --",
    "db:studio": "npm run db:studio --workspace web/backend"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}

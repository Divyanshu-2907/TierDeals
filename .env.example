# ---------------------------------------------------------------------------
# TierDeals environment
#
# Copy to `.env` IN THIS DIRECTORY (the repository root) and fill in. The
# backend resolves the root .env explicitly, since it runs from web/backend.
#
# Every variable here is validated at startup by
# web/backend/src/config/env.ts -- the server refuses to boot on a bad value
# rather than failing later with an undefined.
#
# When you run the app through `shopify app dev`, the Shopify CLI injects
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES into the
# process for you. Keep them here anyway so the server can also be started
# directly (tests, `npm run dev` without the CLI, CI).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://tierdeals:tierdeals@localhost:5433/tierdeals?schema=public

# --- Shopify app credentials ----------------------------------------------
# From the Shopify Partner Dashboard, or `shopify app env show`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of this app. `shopify app dev` sets this to the tunnel URL.
SHOPIFY_APP_URL=https://example.trycloudflare.com

# Comma-separated access scopes. Must match the `scopes` in shopify.app.toml.
SCOPES=write_discounts,read_discounts,read_products,read_orders
